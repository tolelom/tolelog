# 백엔드 API 서버 URL (브라우저 런타임에서 사용)
VITE_API_URL=http://localhost:3000

# 프론트엔드 사이트 URL — canonical / og:url / 구조화 데이터에 사용 (끝의 슬래시 제외)
VITE_SITE_URL=http://localhost:5173

# SSG 빌드 시 sitemap.xml 을 가져올 백엔드 URL.
# 비우면 VITE_API_URL 사용, 그것도 없으면 https://api.tolelom.xyz 폴백.
# CI 빌드에서는 운영 API 를 가리키도록 secrets 에 설정 권장.
# VITE_SSG_API_URL=http://localhost:3000

# Sentry DSN — 설정 시에만 에러 리포팅 활성화. 빈 값이면 console.error 로 폴백.
# https://sentry.io 에서 React 프로젝트 생성 후 받은 DSN 입력.
# VITE_SENTRY_DSN=
